# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables
.env
.env.*

# IDE files
.vscode/
.idea/

# Jupyter
.ipynb_checkpoints/

# Logs
logs/*.log

# Model and generated artifacts
models/*.pkl
models/*.joblib
artifacts/*

# Processed data
data/interim/*
data/processed/*

# Keep folders tracked
!data/interim/.gitkeep
!data/processed/.gitkeep
!artifacts/.gitkeep
!logs/.gitkeep
!models/.gitkeep

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db
# Raw datasets
data/raw/*.csv
!data/raw/.gitkeep
# Python bytecode
__pycache__/
*.py[cod]